# Proofloop Environment Variables Example
# Copy this file to .env and adjust variables as needed

# Application Base URL
APP_BASE_URL=http://localhost:3000

# Database Configuration (PostgreSQL)
# For Docker Compose: postgresql://postgres:postgres@localhost:5432/proofloop
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/proofloop

# PayPal Sandbox Configuration
# Obtain credentials from developer.paypal.com -> Dashboard -> Apps & Credentials
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=your-paypal-sandbox-client-id
PAYPAL_CLIENT_SECRET=your-paypal-sandbox-client-secret

# Server-Side AI Configuration (OpenAI, Gemini, Ollama, etc. compatible endpoint)
# If not provided, Proofloop automatically activates its deterministic AI fallback template engine!
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# Sponsor Integrations (Optional)
# Channel3 Product Discovery API Key
CHANNEL3_API_KEY=

# Elastic Search Configuration (Knowledge store)
# Supports either ELASTICSEARCH_API_KEY or ELASTICSEARCH_USERNAME + ELASTICSEARCH_PASSWORD
ELASTICSEARCH_URL=
ELASTICSEARCH_API_KEY=
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=

# Zapier Webhook URL for Seller Notifications
ZAPIER_WEBHOOK_URL=

# Astropods Agent Observability
ASTROPODS_API_KEY=
